generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum Role {
  USER
  ADMIN
}

enum ApplicationState {
  DRAFT
  PENDING_TAILORING
  TAILORED
  PENDING_SUBMISSION
  SUBMITTED
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AutonomyMode {
  MANUAL
  SEMI_AUTOMATIC
  FULLY_AUTOMATIC
}

enum RemotePreference {
  REMOTE
  HYBRID
  ONSITE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum IngestionStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum NotificationType {
  EMAIL
  IN_APP
}

// ============ CORE USER MODELS ============

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  passwordHash             String
  firstName                String
  lastName                 String
  avatarUrl                String?
  role                     Role      @default(USER)
  isActive                 Boolean   @default(true)
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  resetPasswordToken       String?   @unique
  resetPasswordExpires     DateTime?
  passwordUpdatedAt        DateTime?
  onboardingCompleted      Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  profile       CandidateProfile?
  preferences   UserPreferences?
  personas      Persona[]
  resumes       Resume[]
  applications  Application[]
  notifications Notification[]
}

model CandidateProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  summary          String?
  experience       Json?
  skills           Json?
  education        Json?
  certifications   Json?
  careerGoals      Json?
  location         String?
  remotePreference String?
  salaryExpectation Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personas Persona[]
}

model UserPreferences {
  id                String   @id @default(uuid())
  userId            String   @unique
  jobTitle          String?
  desiredLocations  Json?
  remotePreference  String?
  salaryMin         Int?
  salaryMax         Int?
  jobTypes          Json?
  industries        Json?
  companySize       Json?
  notificationEmail Boolean  @default(true)
  notificationPush  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Persona {
  id              String   @id @default(uuid())
  userId          String
  profileId       String
  name            String
  targetRole      String
  experienceLevel String
  skills          Json
  constraints     Json?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ============ RESUME ============

model Resume {
  id         String   @id @default(uuid())
  userId     String
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  parsedData Json?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ JOB INGESTION ============

model JobSource {
  id        String   @id @default(uuid())
  name      String
  category  String
  baseUrl   String?
  apiConfig Json?
  isActive  Boolean  @default(true)
  isAllowed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingestionLogs IngestionLog[]
  jobPostings   JobPosting[]
}

model IngestionLog {
  id             String          @id @default(uuid())
  jobSourceId    String
  status         IngestionStatus
  jobsIngested   Int             @default(0)
  jobsDuplicated Int             @default(0)
  jobsRejected   Int             @default(0)
  error          String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  jobSource JobSource @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)
}

model JobPosting {
  id               String           @id @default(uuid())
  jobSourceId      String?
  title            String
  company          String
  location         String
  remotePreference RemotePreference
  jobType          JobType
  salaryRange      Json?
  description      String
  requirements     Json?
  skills           Json?
  experiences      Json?
  applyUrl         String
  externalId       String?          @unique
  isExpired        Boolean          @default(false)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  jobSource    JobSource?    @relation(fields: [jobSourceId], references: [id])
  applications Application[]

  @@index([title])
  @@index([company])
  @@index([isExpired])
}

// ============ APPLICATIONS ============

model Application {
  id                  String           @id @default(uuid())
  userId              String
  jobPostingId        String
  state               ApplicationState @default(DRAFT)
  autonomyMode        AutonomyMode     @default(MANUAL)
  tailoredResume      Json?
  tailoredCoverLetter Json?
  notes               String?
  submittedAt         DateTime?
  withdrawnAt         DateTime?
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id])

  @@unique([userId, jobPostingId])
  @@index([userId, state])
}

// ============ AUTOMATION ============

model AutomationRule {
  id             String    @id @default(uuid())
  userId         String
  name           String
  description    String?
  trigger        Json
  conditions     Json?
  actions        Json
  isActive       Boolean   @default(true)
  executionCount Int       @default(0)
  lastExecutedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  executions AutomationExecution[]
}

model AutomationExecution {
  id               String   @id @default(uuid())
  automationRuleId String
  applicationId    String?
  status           String
  input            Json
  output           Json?
  error            String?
  createdAt        DateTime @default(now())

  rule AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
