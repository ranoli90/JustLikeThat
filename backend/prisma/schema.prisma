  description     String
  severity        String   // critical, high, medium, low, info
  cvssScore       Float
  cvssVector      String?
  cveId           String?  // CVE identifier if applicable
  status          String   // open, in_progress, resolved, accepted, false_positive
  affectedSystems String[]
  affectedAssets  String[]
  remediation     String?
  workarounds     String?
  references      String[]
  reportedBy      String?
  scannerType     String?  // sast, dast, pentest, manual
  ticketId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?
  
  @@index([tenantId, status])
  @@index([severity])
  @@index([cvssScore])
  @@index([cveId])
}

model SecurityPolicy {
  id              String   @id @default(uuid())
  tenantId        String?
  name            String
  description     String
  category        String   // access_control, data_protection, incident_response, change_management, vendor_management
  content         Json
  version         Int      @default(1)
  status          String   // draft, active, deprecated
  effectiveDate   DateTime
  reviewDate      DateTime?
  reviewedBy      String?
  approvedBy      String?
  approvalDate    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
  @@index([category])
  @@index([status])
}

model BusinessAssociateAgreement {
  id              String   @id @default(uuid())
  tenantId        String
  vendorName      String
  vendorId        String?
  serviceType     String   // hosting, data_processing, analytics, support, other
  baaStatus       String   // not_required, draft, active, expired, terminated
  signedDate      DateTime?
  expirationDate  DateTime?
  terms           Json?
  attachments     String[]
  contactName     String?
  contactEmail    String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, baaStatus])
}

model PHIAccessLog {
  id              String   @id @default(uuid())
  tenantId        String
  patientId       String   // User ID of data subject
  accessorId     String   // User ID who accessed PHI
  accessorRole   String
  accessType      String   // view, create, update, delete, export, print
  resourceType    String   // medical_record, prescription, lab_result, etc.
  resourceId      String?
  purpose        String?
  ipAddress       String
  userAgent       String?
  details         Json?
  breachDetected  Boolean  @default(false)
  createdAt       DateTime @default(now())
  
  @@index([tenantId, createdAt])
  @@index([patientId])
  @@index([accessorId])
  @@index([accessType])
}

model ThreatIntelligence {
  id              String   @id @default(uuid())
  tenantId        String
  indicatorType   String   // ip, domain, url, hash, email, file
  indicator       String
  threatType      String   // malware, phishing, exploit, botnet, ransomware
  severity        String   // critical, high, medium, low
  source          String   // feed name or source
  confidence      Float    // 0-1 scale
  description     String?
  references      String[]
  firstSeen       DateTime
  lastSeen        DateTime
  expiresAt       DateTime?
  tags            String[]
  isBlocked       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
  @@index([indicatorType, indicator])
  @@index([threatType])
  @@index([isBlocked])
}

model SecurityScore {
  id              String   @id @default(uuid())
  tenantId        String
  overallScore    Float    // 0-100
  category        String   // access, data, infrastructure, compliance, incidents
  score           Float    // 0-100
  factors         Json     // breakdown of factors affecting score
  recommendations Json     // improvement recommendations
  calculatedAt    DateTime @default(now())
  periodStart     DateTime
  periodEnd       DateTime
  
  @@index([tenantId, calculatedAt])
  @@index([category])
}

// ============ ML TRAINING MODELS ============

model MLModel {
  id              String       @id @default(uuid())
  name            String
  type            ModelType
  version         String
  status          String       // training, ready, deprecated
  baseModel       String
  modelPath       String?
  metrics         Json?
  trainingData    Json?
  hyperparameters Json?
  trainedAt       DateTime?
  deployedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  versions       ModelVersion[]
  trainingJobs    TrainingJob[]
  driftDetections DataDriftDetection[]
  explanations   ModelExplanation[]
}

model ModelVersion {
  id              String     @id @default(uuid())
  modelId         String
  version         String
  description     String?
  metrics         Json?
  changelog       String?
  isActive        Boolean    @default(false)
  deployedAt      DateTime?
  deprecatedAt    DateTime?
  createdAt       DateTime   @default(now())
  
  model           MLModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model ABTest {
  id              String        @id @default(uuid())
  name            String
  modelAId        String
  modelBId        String
  trafficSplit    Json          // {modelA: 50, modelB: 50}
  startDate       DateTime
  endDate         DateTime?
  status          String        // running, completed, stopped
  results         Json?
  winner          String?
  confidence      Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model TrainingJob {
  id              String     @id @default(uuid())
  modelId         String
  status          String     // pending, running, completed, failed
  progress        Float      // 0-100
  startedAt       DateTime
  completedAt     DateTime?
  errorMessage    String?
  cost            Float?
  createdAt       DateTime   @default(now())
  
  model           MLModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model DataDriftDetection {
  id              String     @id @default(uuid())
  modelId         String
  metricName      String
  baselineValue   Float
  currentValue    Float
  driftDetected   Boolean
  severity        String?
  detectedAt      DateTime   @default(now())
  
  model           MLModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model ModelExplanation {
  id              String     @id @default(uuid())
  modelId         String
  predictionId    String
  explanationType String     // shap, lime, attention
  explanation     Json
  generatedAt     DateTime   @default(now())
  
  model           MLModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

enum ModelType {
  MATCHING
  RESUME_OPTIMIZATION
  NLU
  VISION
  RECOMMENDATION
  RL_AGENT
}

// ============ ENTERPRISE INTEGRATIONS MODELS ============

model ERPConnection {
  id              String   @id @default(uuid())
  tenantId        String
  provider        String   // sap, oracle, dynamics
  config          Json     // connection settings
  authConfig      Json     // credentials (encrypted)
  status          String   // active, inactive, error
  lastSync        DateTime?
  syncFrequency   String   @default("hourly")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, provider])
}

model CRMConnection {
  id              String   @id @default(uuid())
  tenantId        String
  provider        String   // salesforce, hubspot, zoho
  config          Json
  authConfig      Json
  status          String
  lastSync        DateTime?
  syncFrequency   String   @default("realtime")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, provider])
}

model CorporateLMSConnection {
  id              String   @id @default(uuid())
  tenantId        String
  provider        String   // workday, cornerstone, sap_sf
  config          Json
  authConfig      Json
  status          String
  courseCatalog   Json?
  lastSync        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, provider])
}

model TalentManagementSync {
  id              String   @id @default(uuid())
  tenantId        String
  syncType        String   // succession, performance, compensation
  status          String
  recordsProcessed Int
  errors          Json?
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  
  @@index([tenantId, syncType])
}

model EnterpriseAPIConfig {
  id              String   @id @default(uuid())
  tenantId        String
  rateLimit       Json     // {requests_per_minute: 1000}
  authProviders   Json     // [{type: "oauth2", config: {...}}]
  transformations Json     // Request/response transforms
  apiVersions     Json     // Supported versions
  documentation   String?  // OpenAPI spec URL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
}

model LegacySystemConnection {
  id              String   @id @default(uuid())
  tenantId        String
  systemName      String
  protocol        String   // ftp, sftp, soap, rest
  config          Json     // Connection and protocol settings
  mappings        Json     // Field mappings
  status          String
  lastSync        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, systemName])
}

model DataSyncLog {
  id              String   @id @default(uuid())
  connectionId    String
  connectionType  String   // erp, crm, lms, talent, legacy
  syncType        String   // full, incremental
  status          String   // success, partial, failed
  recordsRead     Int
  recordsWritten  Int
  errors          Json?
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  
  @@index([connectionId, status])
  @@index([connectionType, createdAt])
}

