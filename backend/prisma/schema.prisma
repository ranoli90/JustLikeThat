generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ CORE USER & AUTH MODELS ============

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  role          Role      @default(USER)
  tenantId      String
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resumes       Resume[]
  interviews    InterviewSession[]
}

// ============ MULTI-TENANT MODELS ============

model Tenant {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  domain          String?        @unique
  subdomain       String?        @unique
  plan            PlanType       @default(FREE)
  status          TenantStatus   @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Enterprise features
  enterpriseId    String?
  resourcePool    String?
  slaLevel        SlaLevel?
  dedicatedSupport Boolean       @default(false)
  
  // Data residency
  dataResidency   DataResidency  @default(US)
  
  // Relations
  users           User[]
  resumes         Resume[]
  interviews      InterviewSession[]
  companies        CompanyInsight[]
  jobs            JobPosting[]
  applications    Application[]
  
  // Multi-tenant specific
  branding        TenantBranding?
  featureFlags    TenantFeatureFlag[]
  usages          TenantUsage[]
  billingPlans    BillingPlan[]
  customDomains   CustomDomain[]
  webhooks        TenantWebhook[]
  integrations    TenantIntegration[]
  rateLimits      TenantRateLimit[]
  apiQuotas       TenantApiQuota[]
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum SlaLevel {
  SILVER
  GOLD
  PLATINUM
}

enum DataResidency {
  US
  EU
  APAC
}

// White-Label & Branding
model TenantBranding {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  primaryColor    String   @default("#3B82F6")
  secondaryColor  String   @default("#10B981")
  accentColor     String   @default("#F59E0B")
  backgroundColor String   @default("#FFFFFF")
  textColor       String   @default("#1F2937")
  
  // Assets
  logoUrl         String?
  faviconUrl      String?
  heroImageUrl    String?
 OgImageUrl      String?
  
  // Typography
  primaryFont     String   @default("Inter")
  secondaryFont   String   @default("Roboto")
  customFonts     Json?
  
  // Custom code
  customCss       String?
  customJs        String?
  headerHtml      String?
  footerHtml      String?
  
  // Landing page builder
  landingPageConfig Json?
  
  // Email branding
  emailHeaderHtml String?
  emailFooterHtml String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Feature Flags
model TenantFeatureFlag {
  id              String   @id @default(uuid())
  tenantId        String
  featureName     String
  featureKey      String
  isEnabled       Boolean  @default(true)
  config          Json?
  priority        Int      @default(0)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, featureKey])
}

// Usage Tracking
model TenantUsage {
  id              String   @id @default(uuid())
  tenantId        String
  metricType      String
  metricName      String
  quantity        Float    @default(0)
  unit            String   @default("count")
  periodStart     DateTime
  periodEnd       DateTime
  metadata        Json?
  createdAt       DateTime @default(now())
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, metricType, periodStart])
}

// Billing Plans
model BillingPlan {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  tier            String
  basePrice       Float    @default(0)
  currency        String   @default("USD")
  billingCycle    BillingCycle @default(MONTHLY)
  
  // Usage limits
  includedUsage   Json     @default("{}")
  overageRates    Json     @default("{}")
  
  // Features
  features        Json     @default("[]")
  limits          Json     @default("{}")
  
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  usageAlerts     UsageAlert[]
  
  @@index([tenantId, isActive])
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Invoice {
  id              String        @id @default(uuid())
  tenantId        String
  planId          String
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(DRAFT)
  
  // Amounts
  subtotal        Float
  discount        Float         @default(0)
  tax             Float         @default(0)
  total           Float
  currency        String        @default("USD")
  
  // Period
  periodStart     DateTime
  periodEnd       DateTime
  
  // Line items
  lineItems       Json
  
  // Payment
  paidAt          DateTime?
  paymentMethod   String?
  paymentId       String?
  
  // PDF
  pdfUrl          String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  plan            BillingPlan   @relation(fields: [planId], references: [id])
  
  @@index([tenantId, status])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model UsageAlert {
  id              String        @id @default(uuid())
  tenantId        String
  planId          String
  metricType      String
  threshold       Float
  alertType       AlertType
  isActive        Boolean       @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime      @default(now())
  
  plan            BillingPlan   @relation(fields: [planId], references: [id])
  
  @@index([tenantId, isActive])
}

enum AlertType {
  WARNING
  CRITICAL
}

// Custom Domains
model CustomDomain {
  id              String         @id @default(uuid())
  tenantId        String
  domain          String
  subdomain       String?
  
  // DNS Configuration
  dnsConfig       Json?
  
  // SSL
  sslStatus       SslStatus      @default(PENDING)
  sslCertUrl     String?
  sslExpiresAt   DateTime?
  
  // Verification
  isVerified      Boolean        @default(false)
  verifiedAt      DateTime?
  verificationToken String?
  
  // CDN
  cdnEnabled      Boolean        @default(false)
  
  status          DomainStatus   @default(PENDING)
  errorMessage   String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, domain])
  @@index([domain])
}

enum SslStatus {
  PENDING
  PROVISIONING
  ACTIVE
  EXPIRED
  FAILED
}

enum DomainStatus {
  PENDING
  VERIFIED
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
}

// Webhooks
model TenantWebhook {
  id              String        @id @default(uuid())
  tenantId        String
  name            String
  url             String
  secret          String
  events          String[]
  
  // Configuration
  isActive        Boolean       @default(true)
  headers         Json?
  
  // Retry configuration
  maxRetries      Int           @default(3)
  timeout         Int           @default(30)
  
  // Stats
  totalRequests   Int           @default(0)
  failedRequests  Int           @default(0)
  lastTriggeredAt DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookLogs     WebhookLog[]
  
  @@index([tenantId, isActive])
}

model WebhookLog {
  id              String        @id @default(uuid())
  webhookId       String
  event           String
  payload         Json
  responseStatus  Int?
  responseBody    String?
  error           String?
  duration        Int?
  
  createdAt       DateTime      @default(now())
  
  webhook         TenantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

// Integrations
model TenantIntegration {
  id              String            @id @default(uuid())
  tenantId        String
  provider        IntegrationProvider
  name            String
  
  // Credentials (encrypted)
  credentials     Json?
  
  // Configuration
  config          Json?
  
  // Status
  isActive        Boolean           @default(true)
  lastSyncAt      DateTime?
  syncStatus      SyncStatus        @default(IDLE)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, provider])
}

enum IntegrationProvider {
  SLACK
  DISCORD
  TEAMS
  ZAPIER
  WEBHOOK
  HUBSPOT
  SALESFORCE
  ZENDESK
  JIRA
  CUSTOM
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
}

// Rate Limiting
model TenantRateLimit {
  id              String        @id @default(uuid())
  tenantId        String
  endpoint        String
  method          String        @default("GET")
  
  // Limits
  requestsPerMinute  Int         @default(100)
  requestsPerHour    Int         @default(1000)
  requestsPerDay     Int         @default(10000)
  
  // Burst configuration
  burstSize       Int           @default(10)
  
  isActive        Boolean       @default(true)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, endpoint, method])
}

// API Quotas
model TenantApiQuota {
  id              String        @id @default(uuid())
  tenantId        String
  quotaType       String
  
  // Quota limits
  dailyLimit      Int?
  monthlyLimit    Int?
  yearlyLimit     Int?
  
  // Usage tracking
  currentUsage    Int           @default(0)
  resetAt         DateTime?
  
  isActive        Boolean       @default(true)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, quotaType])
}

// ============ CORE APPLICATION MODELS ============

model Resume {
  id          String         @id @default(uuid())
  tenantId    String
  userId      String
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model InterviewSession {
  id                String             @id @default(uuid())
  tenantId          String
  userId            String
  applicationId     String?
  interviewType     InterviewType
  interviewFormat   InterviewFormat
  scheduledAt       DateTime?
  duration          Int                @default(60)
  status            InterviewStatus    @default(DRAFT)
  notes             String?
  feedback          Json?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           CompanyInsight?
  questions         InterviewQuestion[]
  practices         InterviewPractice[]
  schedules         InterviewSchedule?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

enum InterviewType {
  PHONE_SCREEN
  BEHAVIORAL
  TECHNICAL
  CASE_STUDY
  PANEL
  FINAL
  ONSITE
  VIDEO
  ASSESSMENT
}

enum InterviewFormat {
  VIRTUAL
  ONSITE
  PHONE
  ASYNC_VIDEO
}

enum InterviewStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InterviewQuestion {
  id                String           @id @default(uuid())
  sessionId         String
  questionType      QuestionType
  question          String
  suggestedAnswer   String?
  userAnswer        String?
  difficulty        Difficulty       @default(MEDIUM)
  tags              Json?
  feedback          Json?
  isAnswered        Boolean          @default(false)
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum QuestionType {
  BEHAVIORAL
  TECHNICAL
  SITUATIONAL
  COMPANY_CULTURE
  ROLE_SPECIFIC
  CAREER_GOALS
  SALARY
  GENERAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model CompanyInsight {
  id                String           @id @default(uuid())
  tenantId          String
  name              String
  industry          String?
  size              String?
  location          String?
  website           String?
  culture           String?
  values            Json?
  benefits          Json?
  interviewProcess  String?
  tips              Json?
  salaryRange       Json?
  recentNews        Json?
  glassdoorRating   Float?
  notes             String?
  session           InterviewSession @relation(fields: [id], references: [id], onDelete: Cascade)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model InterviewPractice {
  id                String           @id @default(uuid())
  sessionId         String
  questionId        String?
  question          String
  userAnswer        String
  aiFeedback        Json?
  confidenceScore   Float?
  timeTaken         Int?
  improvementAreas  Json?
  strengths         Json?
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model InterviewSchedule {
  id                String           @id @default(uuid())
  sessionId         String           @unique
  interviewDate     DateTime
  timezone          String           @default("UTC")
  calendarEventUrl  String?
  reminders         Json?
  preparationChecklist Json?
  dressCode         String?
  location          String?
  meetingLink       String?
  attendees         Json?
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model JobPosting {
  id            String    @id @default(uuid())
  tenantId      String
  title         String
  description   String
  requirements  String
  responsibilities String?
  location      String?
  salaryRange   Json?
  jobType       String
  experienceLevel String?
  skills        Json
  benefits      Json?
  companyName   String
  companyLogo   String?
  status        String    @default("DRAFT")
  source        String?
  externalId    String?
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Application {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  jobId         String
  status        String   @default("DRAFT")
  resumeUrl     String?
  coverLetter   String?
  responses     Json?
  score         Float?
  feedback      Json?
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  summary         String?
  experience      Json
  skills          Json
  education       Json
  certifications  Json?
  careerGoals     Json?
  preferences     Json?
  location        String?
  remotePreference String?
  salaryExpectation Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ ANALYTICS MODELS ============

model AnalyticsEvent {
  id          String   @id @default(uuid())
  eventType   String
  userId      String?
  sessionId   String?
  tenantId    String?
  properties  Json
  timestamp   DateTime @default(now())
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

model Dashboard {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  layout      Json
  widgets     Json
  filters     Json?
  isPublic    Boolean  @default(false)
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DashboardWidget {
  id          String   @id @default(uuid())
  dashboardId String
  widgetType  String
  title       String
  config      Json
  position    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
}

model Session {
  id          String   @id @default(uuid())
  userId      String?
  sessionKey  String   @unique
  deviceInfo  Json?
  browserInfo Json?
  ipAddress   String?
  location    Json?
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  duration    Int?
  pageCount   Int      @default(0)
  events      SessionEvent[]
  createdAt   DateTime @default(now())
}

model SessionEvent {
  id          String   @id @default(uuid())
  sessionId   String
  eventType   String
  elementId   String?
  elementType String?
  pageUrl     String?
  x           Float?
  y           Float?
  metadata    Json?
  timestamp   DateTime @default(now())
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model HeatmapData {
  id          String   @id @default(uuid())
  pageUrl     String
  x           Float
  y           Float
  weight      Float    @default(1.0)
  eventType   String   @default("click")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Funnel {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FunnelStep {
  id          String   @id @default(uuid())
  funnelId    String
  stepOrder   Int
  name        String
  eventType   String
  conditions  Json?
}

// ============ AB TESTING MODELS ============

model ABTest {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  description String?
  status      ABTestStatus @default(DRAFT)
  
  // Test configuration
  variants    Json
  trafficAllocation Json?
  targetMetric String
  
  // Schedule
  startDate   DateTime?
  endDate     DateTime?
  
  // Results
  results     Json?
  winner      String?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ABTestStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED
}

model ABTestAssignment {
  id          String   @id @default(uuid())
  testId      String
  userId      String
  variant     String
  converted   Boolean  @default(false)
  convertedAt DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
}

// ============ ML MODELS ============

model MLModelVersion {
  id          String     @id @default(uuid())
  modelType   ModelType
  version     String
  modelPath   String
  accuracy    Float
  deployedAt  DateTime   @default(now())
  isActive    Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model ResumeOptimization {
  id                String   @id @default(uuid())
  resumeId          String
  optimizationScore Float
  keywordScore      Float
  atsScore          Float
  suggestions       Json
  optimizedResume   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model JobMatchPrediction {
  id            String   @id @default(uuid())
  candidateId   String
  jobId         String
  matchScore    Float
  successProb   Float
  factors       Json
  explanation   Json
  createdAt     DateTime @default(now())
}

model NLPAnalysis {
  id              String   @id @default(uuid())
  targetType      String
  targetId        String
  entities        Json
  sentiment       Float
  keyPhrases      Json[]
  skillsExtracted Json
  createdAt       DateTime @default(now())
}

model DocumentAnalysis {
  id              String   @id @default(uuid())
  documentId      String
  documentType    String
  layoutAnalysis  Json?
  signatureDetected Boolean @default(false)
  photoQuality    Float?
  authenticityScore Float?
  categorization  String?
  analysisResult  Json
  createdAt       DateTime @default(now())
}

model PredictionResult {
  id              String   @id @default(uuid())
  predictionType  String
  targetId        String
  prediction      Float
  confidence      Float
  factors         Json
  modelVersion    String
  createdAt       DateTime @default(now())
}

enum ModelType {
  JOB_MATCHING
  RESUME_OPTIMIZATION
  APPLICATION_PREDICTION
  NLU_PROCESSING
  DOCUMENT_VISION
}

// ============ ENUMS ============

enum Role {
  USER
  ADMIN
  RECRUITER
  SUPER_ADMIN
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

// ============ CAREER MODELS ============

model CareerGoal {
  id              String   @id @default(uuid())
  userId          String
  targetRole      String?
  targetIndustry  String?
  targetLocation  String?
  salaryTarget    Int?
  timeline        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CareerMilestone {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  date        DateTime
  type        String
  createdAt   DateTime @default(now())
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String?
  description String?
  createdAt   DateTime @default(now())
}

model NetworkingOpportunity {
  id              String   @id @default(uuid())
  userId          String
  company         String
  contactName     String?
  contactEmail    String?
  linkedinUrl     String?
  status          String   @default("NEW")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WarmIntro {
  id              String   @id @default(uuid())
  userId          String
  targetContactId String?
  company         String
  position         String
  introStatus     String   @default("PENDING")
  message         String?
  createdAt       DateTime @default(now())
}

model SalaryProjection {
  id              String   @id @default(uuid())
  userId          String
  position        String
  company         String?
  location        String
  experienceLevel String
  salaryRange     Json
  confidence      Float
  factors         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model IndustryTrend {
  id              String   @id @default(uuid())
  industry        String
  title           String
  description     String
  impact          String
  source          String?
  publishedAt     DateTime
  createdAt       DateTime @default(now())
}

model Survey {
  id          String   @id @default(uuid())
  userId      String
  title       String
  questions   Json
  responses   Json?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id          String   @id @default(uuid())
  userId      String
  type        String
  content     String
  rating      Int?
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Mentorship {
  id              String   @id @default(uuid())
  mentorId        String
  menteeId        String
  status          String   @default("ACTIVE")
  goals           Json?
  meetingSchedule String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OutreachSequence {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  steps       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
