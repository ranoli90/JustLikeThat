  lastRun         DateTime?
  nextRun         DateTime
  priority        Int      @default(5)
  tenantId        String
  
  // Configuration
  config          Json?    // {enabled: boolean, maxConcurrent: number}
  
  // Stats
  totalRuns       Int      @default(0)
  failedRuns      Int      @default(0)
  
  // Created by
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
