// ============ WORKFLOW ENGINE ============

model WorkflowDefinition {
  id              String   @id @default(uuid())
  name            String
  description     String?
  version         Int      @default(1)
  definition      Json     // Full workflow graph
  status          WorkflowStatus @default(DRAFT)
  tenantId        String
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?
  
  // Relations
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions      WorkflowExecution[]
  nodes           WorkflowNode[]
  schedules       ScheduledWorkflow[]
  history         WorkflowHistory[]
  templates       WorkflowTemplate?
  
  @@index([tenantId, status])
  @@index([tenantId, name])
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

model WorkflowExecution {
  id              String   @id @default(uuid())
  workflowId      String
  version         Int
  status          ExecutionStatus
  trigger         String
  input           Json
  output          Json?
  error           Json?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  nodes           Json     // Node execution state
  
  // Resource tracking
  resourceUsage   Json?
  executionTime   Int?     // milliseconds
  
  // Retry tracking
  retryCount      Int      @default(0)
  parentExecutionId String?
  
  // Relations
  workflow        WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  logs            WorkflowExecutionLog[]
  
  @@index([workflowId, status])
  @@index([trigger])
  @@index([startedAt])
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PAUSED
  CANCELLED
  TIMEOUT
}

model WorkflowExecutionLog {
  id              String   @id @default(uuid())
  executionId     String
  nodeId          String?
  level           LogLevel
  message         String
  data            Json?
  timestamp       DateTime @default(now())
  
  execution       WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  
  @@index([executionId, timestamp])
  @@index([nodeId])
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model WorkflowNode {
  id              String   @id @default(uuid())
  workflowId      String
  nodeId          String
  nodeType        String
  config          Json
  position        Json     // {x, y} coordinates
  connections     Json     // Input/output connections
  
  // Validation
  validationRules Json?
  
  // Relations
  workflow        WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  @@unique([workflowId, nodeId])
  @@index([workflowId])
}

model WorkflowTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String?
  category        String
  definition      Json
  isPublic        Boolean  @default(false)
  usageCount      Int      @default(0)
  tenantId        String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  workflows       WorkflowDefinition[]
  
  @@index([category])
  @@index([isPublic])
}

model ScheduledWorkflow {
  id              String   @id @default(uuid())
