generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector("0.5.0")]
}

// Resume storage
model Resume {
  id          String         @id @default(uuid())
  tenantId    String
  userId      String
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// Interview preparation and coaching
model InterviewSession {
  id                String             @id @default(uuid())
  tenantId          String
  userId            String
  applicationId     String?
  interviewType     InterviewType
  interviewFormat   InterviewFormat
  scheduledAt       DateTime?
  duration          Int                @default(60) // minutes
  status            InterviewStatus    @default(DRAFT)
  notes             String?
  feedback          Json?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           CompanyInsight?
  questions         InterviewQuestion[]
  practices         InterviewPractice[]
  schedules         InterviewSchedule?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

enum InterviewType {
  PHONE_SCREEN
  BEHAVIORAL
  TECHNICAL
  CASE_STUDY
  PANEL
  FINAL
  ONSITE
  VIDEO
  ASSESSMENT
}

enum InterviewFormat {
  VIRTUAL
  ONSITE
  PHONE
  ASYNC_VIDEO
}

enum InterviewStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Interview questions and answers
model InterviewQuestion {
  id                String           @id @default(uuid())
  sessionId         String
  questionType      QuestionType
  question          String
  suggestedAnswer   String?
  userAnswer        String?
  difficulty        Difficulty       @default(MEDIUM)
  tags              Json?
  feedback          Json?
  isAnswered        Boolean          @default(false)
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum QuestionType {
  BEHAVIORAL
  TECHNICAL
  SITUATIONAL
  COMPANY_CULTURE
  ROLE_SPECIFIC
  CAREER_GOALS
  SALARY
  GENERAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// Company research and insights
model CompanyInsight {
  id                String           @id @default(uuid())
  tenantId          String
  name              String
  industry          String?
  size              String?
  location          String?
  website           String?
  culture           String?
  values            Json?
  benefits          Json?
  interviewProcess  String?
  tips              Json?
  salaryRange       Json?
  recentNews        Json?
  glassdoorRating   Float?
  notes             String?
  session           InterviewSession @relation(fields: [id], references: [id], onDelete: Cascade)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// Interview practice sessions
model InterviewPractice {
  id                String           @id @default(uuid())
  sessionId         String
  questionId        String?
  question          String
  userAnswer        String
  aiFeedback        Json?
  confidenceScore   Float?
  timeTaken         Int?            // seconds
  improvementAreas  Json?
  strengths         Json?
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// Interview scheduling
model InterviewSchedule {
  id                String           @id @default(uuid())
  sessionId         String           @unique
  interviewDate     DateTime
  timezone          String           @default("UTC")
  calendarEventUrl  String?
  reminders         Json?
  preparationChecklist Json?
  dressCode         String?
  location          String?
  meetingLink       String?
  attendees         Json?
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// Salary negotiation preparation
model SalaryNegotiation {
  id                String           @id @default(uuid())
  tenantId          String
  userId            String
  company           String
  position          String
  marketRange       Json?
  targetSalary      Int?
  minimumAcceptable Int?
  benefits          Json?
  negotiationStrategy Json?
  talkingPoints     Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// Post-interview follow-up
model PostInterviewAction {
  id                String           @id @default(uuid())
  tenantId          String
  userId            String
  applicationId     String
  interviewDate     DateTime
  followUpType      FollowUpType
  status            ActionStatus     @default(PENDING)
  dueDate           DateTime?
  message           String?
  sentAt            DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum FollowUpType {
  THANK_YOU
  SECONDARY_FOLLOW_UP
  DECISION_REQUEST
  OFFER_NEGOTIATION
  WITHDRAWAL
}

enum ActionStatus {
  PENDING
  SENT
  COMPLETED
  SKIPPED
}
