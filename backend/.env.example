# =============================================================================
# Environment Configuration Example
# Copy this file to .env and fill in the values
# =============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password
DB_DATABASE=apply_as_a_service

# JWT Configuration (REQUIRED - minimum 32 characters)
JWT_SECRET=your_very_long_secure_jwt_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=your_very_long_secure_refresh_token_secret_at_least_32_chars

# ClickHouse Analytics Database (REQUIRED)
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=your_secure_clickhouse_password
CLICKHOUSE_DATABASE=analytics

# Encryption Configuration (REQUIRED)
ENCRYPTION_KEY=your_very_long_encryption_key_at_least_32_chars
ENCRYPTION_SALT=your_unique_encryption_salt_string

# MFA Encryption Key (REQUIRED for production)
MFA_ENCRYPTION_KEY=your_very_long_mfa_encryption_key_at_least_32_chars

# Application Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# AWS Configuration (optional - for S3 uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Redis Configuration (optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Email Configuration (optional - for password resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@applyasaservice.com

# OpenAI Configuration (optional - for AI features)
OPENAI_API_KEY=your_openai_api_key

# LinkedIn Integration (optional)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Security Settings
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
